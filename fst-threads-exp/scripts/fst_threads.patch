diff --git a/python/sglang/srt/model_loader/weight_utils.py b/python/sglang/srt/model_loader/weight_utils.py
index ef672c5..15646d9 100644
--- a/python/sglang/srt/model_loader/weight_utils.py
+++ b/python/sglang/srt/model_loader/weight_utils.py
@@ -750,9 +750,15 @@ def fastsafetensors_weights_iterator(
 
     device = torch.device(f"cuda:{rank}")
 
+    # Axis 1 -- files in flight. Upstream hard-codes one file per rank, so a TP=4
+    # launch reads only 4 shards concurrently. Default 1 is byte-for-byte
+    # upstream behavior. (Same knob as lustre-loading-exp phase 3.)
+    files_per_rank = int(os.getenv("SGLANG_FST_FILES_PER_RANK", "1"))
+    chunk = pg.size() * files_per_rank
+
     weight_files_sub_lists = [
-        hf_weights_files[i : i + pg.size()]
-        for i in range(0, len(hf_weights_files), pg.size())
+        hf_weights_files[i : i + chunk]
+        for i in range(0, len(hf_weights_files), chunk)
     ]
 
     _BAR_FORMAT = (
@@ -765,8 +771,25 @@ def fastsafetensors_weights_iterator(
         disable=False,
         bar_format=_BAR_FORMAT,
     ):
-        loader = SafeTensorsFileLoader(pg, device)
-        rank_file_map = {i: [f] for i, f in enumerate(f_list)}
+        # Axis 2 -- reader threads WITHIN each file. Shards are stripe_count=1, so
+        # one file is one OST, and an OST's throughput is (requests in flight) x
+        # bytes / latency. Unset leaves fastsafetensors' own defaults
+        # (max_threads=16, bbuf_size_kb=16384) untouched.
+        fst_kwargs = {}
+        _mt = os.getenv("SGLANG_FST_MAX_THREADS")
+        if _mt:
+            fst_kwargs["max_threads"] = int(_mt)
+        _bb = os.getenv("SGLANG_FST_BBUF_SIZE_KB")
+        if _bb:
+            fst_kwargs["bbuf_size_kb"] = int(_bb)
+        loader = SafeTensorsFileLoader(pg, device, **fst_kwargs)
+        # Round-robin the chunk across ranks. At files_per_rank=1 this reduces
+        # exactly to upstream's `{i: [f] for i, f in enumerate(f_list)}`.
+        rank_file_map = {}
+        for rank_idx in range(pg.size()):
+            rank_files = f_list[rank_idx :: pg.size()]
+            if rank_files:
+                rank_file_map[rank_idx] = rank_files
         loader.add_filenames(rank_file_map)
         try:
             fb = loader.copy_files_to_device()
