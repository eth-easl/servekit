# Foundry-enabled SGLang image for the Apertus-8B DP=4 cold-start experiment.
#
# Derived from the SAME image the baseline uses, so baseline and foundry runs
# share one engine build. The sglang patch is inert without
# --foundry-graph-extension-config-path (apply_server_args returns early), so
# this single image serves all three runs and the only variable is that flag.
#
# We deliberately do NOT use the foundry-org/sglang fork: its whole diff is 47
# lines across 4 files, and every anchor already exists in v0.5.10. See
# apply_foundry_patch.py.
# v0.5.11, NOT v0.5.10. foundry's integration imports
# sglang.srt.model_executor.pool_configurator, which upstream introduced in
# v0.5.11 -- the same release that moved to torch 2.11 / CUDA 13.0.1. v0.5.10
# needed a compat shim for it and would have kept drifting from foundry's target
# internals. Bristen's driver is 590.48.01, well past the r580 CUDA 13 needs.
#
# Fully qualified: this host's unqualified-search registries resolve bare names
# to registry.suse.com, which 403s on this repo.
FROM docker.io/lmsysorg/sglang:v0.5.11

# Base is ubuntu24.04 (noble), which ships Boost exactly 1.83 -- the minimum
# foundry's CMakeLists requires (find_package(Boost 1.83.0 CONFIG ...)).
RUN apt-get update && apt-get install -y --no-install-recommends \
        libboost-filesystem-dev libboost-json-dev \
    && rm -rf /var/lib/apt/lists/*

# cmake>=4.0 is a hard requirement (cmake_minimum_required(VERSION 4.0)); the
# distro's is 3.28. fastsafetensors is baked in here rather than pip-installed
# per run, so it stays out of the measured cold-start window.
RUN pip install --no-cache-dir "cmake>=4.0" ninja fastsafetensors

# foundry.ops links -lcuda, but the build host has no GPU driver. Link against
# the CUDA driver stub; the real driver is injected at runtime by the container
# hook. LIBRARY_PATH affects link time only, never runtime resolution.
ENV LIBRARY_PATH=/usr/local/cuda/lib64/stubs:${LIBRARY_PATH}

# --no-build-isolation is required: foundry's setup.py imports torch at build
# time and must see the image's torch 2.9.1 (its build-requires pins 2.9.0).
#
# --no-deps is REQUIRED for experiment validity, not just speed. foundry declares
# dependencies = ["torch"], and resolving that re-pins torch's CUDA extras: it
# silently downgraded the image's nccl 2.28.3 -> 2.27.5 and cudnn 9.16.0 -> 9.10.2.
# That would change the engine underneath SGLang and break the whole premise that
# baseline and foundry runs share one build. torch is already installed.
COPY foundry /opt/foundry
RUN cd /opt/foundry && pip install -e . --no-build-isolation --no-deps

# NOTE: the sglang patch is deliberately NOT baked in here. apply_foundry_patch.py
# runs at job start instead (see apertus8b_dp4.sbatch), because:
#   - it is idempotent and takes well under a second,
#   - it runs before the profiled launch, so it stays outside the measured window,
#   - and iterating on the patch then costs seconds instead of a ~10 min rebuild
#     and 28 GB squashfs re-export.
# This image is therefore just the heavy, slow-moving dependencies.
#
# No `import foundry` smoke test here either -- foundry.ops needs libcuda.so.1,
# which does not exist on a GPU-less build host. The sbatch verifies it on the
# compute node instead.
