+            # Optional: read shards from a hugepage-backed buffer staged by an
+            # external hugepage_stage_daemon.py process, instead of safe_open
+            # on disk. See hugepage-sharded-loading-exp/PLAN.md + NOTES.md.
+            # Every tensor in a sharded_state checkpoint is already contiguous
+            # (the TP narrow was done once, offline, at save time), so a
+            # direct cudaMemcpyAsync off the registered buffer replaces both
+            # safe_open's mmap'd-pageable read AND any bounce-buffer copy --
+            # no pinned staging buffer is needed here, unlike the default
+            # (unsharded) loader's strided case.
+            hugepage_sock = os.environ.get("SGLANG_HUGEPAGE_SHARDED_SOCK")
+            hugepage_result = None
+            if hugepage_sock:
+                import hugepage_client
+
+                tag = f"TP{rank}"
+                rank_pattern = self.pattern.format(rank=rank, part="*")
+                hugepage_result = hugepage_client.get_rank_files_meta(
+                    hugepage_sock, rank_pattern, tag=tag
+                )
+                if hugepage_result is not None:
+                    _, ordered = hugepage_result
+                    staged_names = {f["filename"] for f in ordered}
+                    disk_names = {os.path.basename(p) for p in filepaths}
+                    if staged_names != disk_names:
+                        logger.warning(
+                            "hugepage staging covers %s but disk has %s -- "
+                            "falling back to safe_open for this rank",
+                            sorted(staged_names),
+                            sorted(disk_names),
+                        )
+                        hugepage_result = None
+
+            if hugepage_result is not None:
+                import hugepage_safetensors
+
+                buf, ordered = hugepage_result
+                # Registration is synchronous, on THIS (main) thread -- not a
+                # background thread. cudaMemcpyAsync itself doesn't block the
+                # CPU, so "register next chunk right after issuing this
+                # file's copies" still overlaps that chunk's registration
+                # with the GPU draining the copies just issued, without ever
+                # calling cudaHostRegister and cudaMemcpyAsync from different
+                # threads at the same time (see NOTES.md on why that's
+                # avoided). Chunk boundaries are aligned to tensor
+                # boundaries (never mid-tensor) -- see PipelinedRegistrar's
+                # docstring for why that's required, not optional.
+                registrar = hugepage_client.PipelinedRegistrar(
+                    buf, ordered, tag=tag, device_id=torch.cuda.current_device()
+                )
+                stream_ptr = torch.cuda.current_stream().cuda_stream
+
+                for i, f in enumerate(ordered):
+                    for key, tensor in hugepage_safetensors.iter_tensors(
