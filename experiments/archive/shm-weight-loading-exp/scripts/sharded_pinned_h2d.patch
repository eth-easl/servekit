@@ -1425,6 +1425,33 @@ class ShardedStateLoader(BaseModelLoader):
                     f"pre-sharded checkpoints are currently supported!"
                 )
             state_dict = self._filter_subtensors(model.state_dict())
+
+            # Optional: stage each shard through pinned host memory.
+            #
+            # safe_open yields an mmap'd PAGEABLE cpu tensor, so param_data.copy_
+            # makes the driver bounce every byte through its own small internal
+            # staging buffer (measured ~3.3 GB/s against a ~20 GB/s DMA ceiling).
+            # Staging explicitly replaces that with one contiguous memcpy into a
+            # pinned buffer plus a real DMA.
+            #
+            # This only pays off HERE. A stored shard is already contiguous and
+            # in final layout -- the TP de-stride was paid offline by the save
+            # job -- so the memcpy runs at full memory bandwidth and moves 1x the
+            # bytes. The same trick applied to the default loader fought strided
+            # slices, and applied to a whole-file loader moved TP x the bytes.
+            #
+            # Two buffers + events: tensor N+1's memcpy overlaps tensor N's DMA.
+            use_pinned = os.environ.get("SGLANG_SHARDED_PINNED_H2D", "0").lower() not in (
+                "0",
+                "false",
+                "",
+            )
+            pin_bufs = [None, None]
+            pin_evs = [torch.cuda.Event() for _ in range(2)]
+            for _ev in pin_evs:
+                _ev.record()
+            pin_slot = 0
+
             for path in filepaths:
                 with safe_open(path, framework="pt") as f:
                     for key in f.keys():  # noqa: SIM118
@@ -1445,8 +1472,40 @@ class ShardedStateLoader(BaseModelLoader):
                                 key,
                                 param_shape,
                             )
-                        param_data.copy_(tensor)
+                        if (
+                            use_pinned
+                            and param_data.is_cuda
+                            and tensor.device.type == "cpu"
+                            and tensor.is_contiguous()
+                        ):
+                            nbytes = tensor.numel() * tensor.element_size()
+                            k = pin_slot
+                            pin_slot ^= 1
+                            # This slot's previous DMA must have drained before
+                            # its pinned buffer is overwritten. The OTHER slot's
+                            # DMA may still be in flight -- that is the overlap.
+                            pin_evs[k].synchronize()
+                            if pin_bufs[k] is None or pin_bufs[k].numel() < nbytes:
+                                pin_bufs[k] = torch.empty(
+                                    nbytes, dtype=torch.uint8, pin_memory=True
+                                )
+                            staged = (
+                                pin_bufs[k][:nbytes]
+                                .view(tensor.dtype)
+                                .view(tensor.shape)
+                            )
+                            staged.copy_(tensor)  # pageable -> pinned, contiguous
+                            param_data.copy_(staged, non_blocking=True)  # real DMA
+                            pin_evs[k].record()
+                        else:
+                            param_data.copy_(tensor)
                         state_dict.pop(key)
+
+            if use_pinned:
+                # pin_bufs are about to go out of scope. Freeing a pinned buffer
+                # while its DMA is still reading corrupts the copy.
+                torch.cuda.synchronize()
+
             if state_dict:
