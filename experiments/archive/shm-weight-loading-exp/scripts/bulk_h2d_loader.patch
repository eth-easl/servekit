+# safetensors dtype strings -> torch dtypes, for reinterpreting a raw byte blob.
+_ST_STR_TO_TORCH_DTYPE = {
+    "F64": torch.float64,
+    "F32": torch.float32,
+    "F16": torch.float16,
+    "BF16": torch.bfloat16,
+    "I64": torch.int64,
+    "I32": torch.int32,
+    "I16": torch.int16,
+    "I8": torch.int8,
+    "U8": torch.uint8,
+    "BOOL": torch.bool,
+}
+for _st_name, _torch_attr in (("F8_E4M3", "float8_e4m3fn"), ("F8_E5M2", "float8_e5m2")):
+    if hasattr(torch, _torch_attr):
+        _ST_STR_TO_TORCH_DTYPE[_st_name] = getattr(torch, _torch_attr)
+
+
+def _read_safetensors_header(st_file: str):
+    """Parse a safetensors header without touching tensor data.
+
+    Layout: 8-byte little-endian header length, then that many bytes of JSON
+    mapping name -> {"dtype", "shape", "data_offsets": [begin, end]} (byte
+    offsets relative to the start of the data region), then the packed data.
+    """
+    with open(st_file, "rb") as f:
+        header_len = int.from_bytes(f.read(8), "little")
+        header = json.loads(f.read(header_len))
+    header.pop("__metadata__", None)
+    data_start = 8 + header_len
+    data_nbytes = os.path.getsize(st_file) - data_start
+    return header, data_start, data_nbytes
+
+
+def bulk_h2d_weights_iterator(
+    hf_weights_files: List[str],
+    device: Optional[torch.device] = None,
+) -> Generator[Tuple[str, torch.Tensor], None, None]:
+    """Whole-file bulk host->device weight iterator for a RAM-resident source.
+
+    A safetensors file is one contiguous blob. Instead of the default loader's
+    per-tensor strided H2D copies (~2 GB/s on a TP-sharded slice), for each
+    file this:
+
+      1. reads the entire data region into a pinned host buffer (contiguous,
+         threaded memcpy),
+      2. issues ONE contiguous H2D DMA of that buffer to a GPU blob,
+      3. yields per-tensor VIEWS into the GPU blob.
+
+    The engine's weight_loader then narrows + copies on the GPU (D2D, ~free),
+    so no host-side de-stride happens and no weight_loader is modified. Two
+    pinned buffers + CUDA events double-buffer the host read against the
+    in-flight DMA: the memcpy of file N+1 overlaps the DMA of file N.
+
+    Trade-off: every TP rank receives the FULL (unsharded) tensor and narrows
+    on-device, so this moves ~TP x the bytes -- it wins only because contiguous
+    transfer is far faster than the strided per-shard copy. Intended for
+    weights already staged in RAM (e.g. /dev/shm).
+    """
+    if not hf_weights_files:
+        return
+    if device is None:
+        device = torch.device(f"cuda:{torch.cuda.current_device()}")
+
+    enable_tqdm = (
+        not torch.distributed.is_initialized() or torch.distributed.get_rank() == 0
+    )
+
+    headers = [_read_safetensors_header(f) for f in hf_weights_files]
+    max_nbytes = max(dn for _, _, dn in headers)
+
+    # Size both double-buffer slots to the largest file so buffers allocate once.
+    host_bufs = [
+        torch.empty(max_nbytes, dtype=torch.uint8, pin_memory=True) for _ in range(2)
+    ]
+    gpu_bufs = [
+        torch.empty(max_nbytes, dtype=torch.uint8, device=device) for _ in range(2)
+    ]
+    # Per-slot event: fires when that slot's last H2D has drained, i.e. its
+    # pinned buffer is safe to overwrite. Pre-record as already-complete.
+    h2d_done = [torch.cuda.Event() for _ in range(2)]
+    for ev in h2d_done:
+        ev.record()
+    torch.cuda.synchronize()
+
+    for i in tqdm(
+        range(len(hf_weights_files)),
+        desc="Loading safetensors (bulk H2D)",
+        disable=not enable_tqdm,
+    ):
+        st_file = hf_weights_files[i]
+        header, data_start, data_nbytes = headers[i]
+        k = i % 2
+
+        # Don't clobber this slot's pinned buffer until its previous DMA is
+        # done. The OTHER slot's DMA may still be running -- this read overlaps
+        # it, which is the point of double-buffering. GPU-blob reuse needs no
+        # explicit wait: the next H2D into it is stream-ordered after this
+        # file's consumer D2D copies.
+        h2d_done[k].synchronize()
+
+        host = host_bufs[k][:data_nbytes]
+        src = torch.from_file(
+            st_file, shared=True, size=data_start + data_nbytes, dtype=torch.uint8
+        )
+        host.copy_(src[data_start:])  # contiguous tmpfs -> pinned (threaded)
+        del src
+
+        gpu = gpu_bufs[k][:data_nbytes]
+        gpu.copy_(host, non_blocking=True)  # ONE contiguous H2D DMA
+        h2d_done[k].record()
+
+        for name, meta in header.items():
+            begin, end = meta["data_offsets"]
+            dtype = _ST_STR_TO_TORCH_DTYPE[meta["dtype"]]
+            seg = gpu[begin:end]
+            try:
+                typed = seg.view(dtype)
+            except RuntimeError:
+                # Misaligned byte offset for this dtype: fall back to a fresh
+                # (offset-0) copy on the GPU, still a cheap D2D.
+                typed = seg.clone().view(dtype)
+            yield name, typed.reshape(meta["shape"])
+
+
 def fastsafetensors_weights_iterator(
     hf_weights_files: List[str],
 ) -> Generator[Tuple[str, torch.Tensor], None, None]:
