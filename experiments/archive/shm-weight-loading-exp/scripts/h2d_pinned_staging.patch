+# Reusable per-process pinned staging buffer for host->device weight copies.
+# One buffer, grown to the largest slice seen (117 MB for Llama-70B down_proj
+# at TP=4) and then reused by every subsequent tensor. Sizing it per-tensor
+# rather than per-model is the point: pinning cost scales with bytes pinned,
+# benefit scales with bytes transferred, so a conveyor belt beats a warehouse.
+# (Pinning the whole 141 GB model measures 3-4 GB/s of cudaHostRegister =
+# 31-54 s per rank. Not viable.)
+_h2d_staging_buffer = None
+
+# Below this the per-call overhead outweighs the copy. Nearly all of the
+# model's bytes live in a few hundred large tensors; the long tail of
+# norms/biases is not worth staging.
+_H2D_MIN_BYTES = 1 << 20
+
+
+def h2d_copy_(param_data: torch.Tensor, loaded_weight: torch.Tensor) -> None:
+    """`param_data.copy_(loaded_weight)`, staged through pinned host memory.
+
+    A pageable source forces the CUDA driver to bounce every byte through its
+    own internal pinned buffer, using a memcpy that does not parallelize over
+    OMP threads -- 2.05 GB/s per rank at TP=4, against 18-24 GB/s of
+    available DMA bandwidth. Staging relocates that same host-side work into
+    torch's threaded copy_, and de-strides the narrowed slice in the same
+    pass. Measured 2.23 -> 7.70 GB/s on RowParallel slices.
+
+    Falls through to a plain copy_ whenever staging cannot pay off: opted
+    out, not a host->device copy, source already pinned, or too small. Those
+    cases must behave exactly as before.
+    """
+    global _h2d_staging_buffer
+
+    nbytes = loaded_weight.numel() * loaded_weight.element_size()
+    if (
+        not _H2D_PINNED_STAGING
+        or not param_data.is_cuda
+        or loaded_weight.device.type != "cpu"
+        or loaded_weight.is_pinned()
+        or nbytes < _H2D_MIN_BYTES
+    ):
+        param_data.copy_(loaded_weight)
+        return
+
+    if _h2d_staging_buffer is None or _h2d_staging_buffer.numel() < nbytes:
+        # Drop the old buffer first, so peak pinned footprint is the new size
+        # rather than old + new.
+        _h2d_staging_buffer = None
+        try:
+            _h2d_staging_buffer = torch.empty(
+                nbytes, dtype=torch.uint8, pin_memory=True
+            )
+        except RuntimeError:
+            # Pinned allocation can fail under memory pressure. Never turn a
+            # weight load into a crash over an optimization.
+            logger.warning(
+                "h2d_copy_: pinned staging allocation failed, using plain copy_"
+            )
+            param_data.copy_(loaded_weight)
+            return
+
+    staged = (
+        _h2d_staging_buffer[:nbytes]
+        .view(loaded_weight.dtype)
+        .view(loaded_weight.shape)
+    )
+    # 1. CPU -> pinned CPU. This is the step that parallelizes over OMP
+    #    threads, and it also makes the narrowed slice contiguous.
+    staged.copy_(loaded_weight)
+    # 2. Pinned -> GPU. Deliberately BLOCKING: with a single reusable buffer a
+    #    non_blocking copy would let the next tensor's staged.copy_() overwrite
+    #    these bytes while the DMA is still reading them. Overlap buys ~nothing
+    #    here anyway (measured 7.70 vs 7.60 GB/s predicted for fully serial,
+    #    the CPU side being the limiting stage), so correctness is free.
+    param_data.copy_(staged)
+
+
