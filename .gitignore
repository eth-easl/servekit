# Local agent / tooling state (logs, session, HUD, metrics)
.omx/

# Coding-agent harness state (skills, worktrees, session data)
.agents/
.claude/

# Personal scratch deployment configs (user-suffixed)
deploy/*-xzyao/

# Python caches
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# C++ build output
snapshot/build/
*.o
*.a

# Compiled shared objects (built artifacts, e.g. libsnapshot_*.so)
*.so

# Recorder / redirect / measurement output dirs (written on the cluster)
snapshot/record-synthetic/
snapshot/record-vllm/
snapshot/redirect-vllm/
snapshot/alloc-determinism/
snapshot/measure-init/

# Logs and Slurm output
*.log
slurm-*.out

# Secrets / environment
.env
.env.*

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
