+    # this through, so every loader is stuck at the library default of 16
+    # threads over a 16 MB-per-thread pinned bounce buffer (256 MB total,
+    # since fastsafetensors sizes the cudaHostAlloc as bbuf_size_kb *
+    # max_threads -- see fastsafetensors/cpp/ext.cpp,
+    # nogds_file_reader::submit_read). The default of 16 here is byte-for-byte
+    # upstream behavior; raising it scales the pinned buffer accordingly (no
+    # separate knob needed).
+    max_threads = int(os.getenv("SGLANG_FST_MAX_THREADS", "16"))
+
